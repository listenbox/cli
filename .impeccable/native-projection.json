    "nativeWorkspace": "../crates/desktop/src/workspace.rs",
    "nativePlatform": "../crates/desktop/src/platform.rs",
    "nativeLifecycle": "../crates/desktop/src/quit.rs"
  },
  "projection": {
    "appearance": "system",
    "layout": {
      "rail": "240px",
      "toolbar": "56px",
      "windowDefault": "1080px 760px",
      "windowMinimum": "840px 600px",
      "contentPadding": "24px",
      "controlGap": "12px",
      "rowGap": "8px",
      "rowPaddingY": "12px",
      "themeRadius": "10px"
    },
    "roleMap": {
      "background": {
        "light": "bg",
        "dark": "dark-bg"
      },
      "sheet": {
        "light": "sheet",
        "dark": "dark-sheet"
      },
      "rail": {
        "light": "rail",
        "dark": "dark-rail"
      },
      "ink": {
        "light": "ink",
        "dark": "dark-ink"
      },
      "muted": {
        "light": "muted",
        "dark": "dark-muted"
      },
      "border": {
        "light": "border",
        "dark": "dark-border"
      },
      "divider": {
        "light": "divider",
        "dark": "dark-divider"
      },
      "selected": {
        "light": "navigation-active",
        "dark": "dark-navigation-active"
      },
      "action": {
        "light": "primary",
        "dark": "dark-primary"
      },
      "status": {
        "danger": "native RGB status values in tokens.rs"
      }
    },
    "primitives": {
      "action": "Button::primary()",
      "quietAction": "Button::ghost()",
      "field": "Input::new()",
      "progress": "Progress::new()",
      "loading": "Spinner::new().small()"
    }
  },
  "guardrails": [
    "Use semantic role mappings rather than local colors.",
    "Keep the native surface flat and border-led.",
    "Keep one clear action hierarchy in each selected-show state.",
    "Do not use Mazit UI as a visual reference.",
    "Treat the DESIGN.md projection drift as recorded evidence, not a new token source."
  ],
  "review": {
    "disposition": "ship",
    "materialFixes": "none",
    "captures": [
      "review/welcome.png",
      "review/workspace-light.png",
      "review/workspace-dark.png"
    ]
  }
